<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SecureDeviceBridge</RootNamespace>
    <AssemblyName>SecureDeviceBridge</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>SecureDeviceBridge</Authors>
    <Description>Universal hardware bridge for TPM 2.0 cryptographic operations via Minimal APIs</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TSS" Version="2.1.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.*" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.*" />
  </ItemGroup>

</Project>
